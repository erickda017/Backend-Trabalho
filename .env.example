PORT=3333

# Identificador da sessão do WhatsApp (Baileys), salva na tabela whatsapp_sessions
# do Supabase em vez de arquivo em disco. Deixe "default" a menos que você vá rodar
# mais de uma sessão/número ao mesmo tempo.
WHATSAPP_SESSION_ID=default

# Origem(ns) permitidas pelo CORS, separadas por vírgula.
# Ex: https://seu-frontend.vercel.app
# Deixe em branco em dev para liberar qualquer origem.
FRONTEND_ORIGIN=

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Nome do bucket de PDFs no Supabase Storage
SUPABASE_BUCKET=faturas

# Nome do bucket de mídia do Chat (fotos/áudios/documentos trocados no WhatsApp)
SUPABASE_CHAT_BUCKET=chat-midia

# Delay entre disparos (ms) - importante para evitar bloqueio do WhatsApp
MIN_DELAY_MS=5000
MAX_DELAY_MS=15000

# Limite diário de mensagens (soma de todos os envios). 0 = sem limite.
DAILY_LIMIT=300

# A cada N mensagens, faz uma pausa mais longa (comportamento mais humano)
BATCH_SIZE=20
BATCH_PAUSE_MS=600000

# Webhook opcional: URL que recebe eventos (mensagem enviada, entregue, lida, erro, etc.)
WEBHOOK_URL=
# Além de ir no header X-Webhook-Secret, assina o corpo (HMAC-SHA256) no
# header X-Webhook-Signature (formato "sha256=<hex>") -- quem recebe pode
# recalcular o HMAC do corpo cru com este mesmo segredo e comparar, pra
# confirmar que o payload não foi adulterado no caminho.
WEBHOOK_SECRET=

# Extrator de PIX -- limites de upload por requisição (padrões já cobrem até
# 400 PDFs / 800MB no total, o máximo que a aba Pix aceita hoje).
PIX_MAX_ARQUIVOS=400
PIX_MAX_ARQUIVO_MB=20
PIX_MAX_TOTAL_MB=800

# Extração de Pix "no servidor" (opção 2, além da extração padrão no
# navegador) -- processa 1 PDF por requisição, então o limite é só por
# arquivo (ver services/extratorServidorPix.js e CONTEXTO.md).
PIX_SERVIDOR_MAX_ARQUIVO_MB=12

# Depois de quantos dias um PDF de fatura (anexado a um cliente) ou um boleto
# enviado pro Extrator de PIX é apagado automaticamente (banco + Storage).
RETENCAO_FATURAS_DIAS=40

# Cloudflare Worker de OCR (extrai vencimento/valor/Pix de boletos) -- mesmo
# worker usado pelo Extrator de PIX no front (ver frontend/.env.example,
# VITE_WORKER_URL). Usado pela verificação em massa de vencimento
# (services/verificacaoVencimentos.js), que roda no backend.
WORKER_URL=https://processo-de-pdf.erickramiro2010.workers.dev

# Delay (ms) entre cada cliente na verificação em massa de vencimento -- evita
# martelar o OCR.space (rate limit de terceiro) e a RAM/CPU do servidor.
VERIFICACAO_VENCIMENTO_DELAY_MS=1500

# ---------------------------------------------------------------------------
# [2026-10] Cloudflare R2 -- armazenamento de arquivos (PDFs, mídia do chat,
# fotos de disparo, avatares). SÓ NO BACKEND, nunca no front. Com as 4
# variáveis preenchidas, todo arquivo NOVO vai pro R2; arquivos antigos
# continuam sendo lidos do Supabase Storage até serem migrados
# (node scripts/migrarStorageParaR2.js --executar / --verificar).
# Sem elas, tudo continua no Supabase Storage como antes.
# Ver src/lib/armazenamento.js.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket PRIVADO (não ativar acesso público nem domínio público nele).
R2_BUCKET_NAME=
# Depois de rodar `--verificar` sem pendências, "false" para de procurar
# arquivo no Supabase Storage (fallback). Padrão: ligado.
STORAGE_LEGADO_SUPABASE=true

# Teto por PDF em POST /faturas/avulsas (MB). Supabase Storage free recusa >50MB por objeto.
FATURA_AVULSA_MAX_MB=100

# [2026-10] true = reativa em produção os logs detalhados de diagnóstico (ex.: cada evento messages.upsert do Baileys). Deixe vazio no dia a dia.
LOG_VERBOSE=
